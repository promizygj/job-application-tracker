NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://jat:jat_dev_password@localhost:5432/job_tracker?schema=public"
CLIENT_URL=http://localhost:3000
# Generate with: openssl rand -base64 33 — must match AUTH_SECRET in client/.env.local
AUTH_SECRET=
# Generate with: openssl rand -base64 33 — must match INTERNAL_API_SECRET in client/.env.local
INTERNAL_API_SECRET=
# Optional. Leave empty in dev to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="JobTrack <no-reply@jobtrack.local>"
# File storage: "local" saves uploads under UPLOAD_DIR (git-ignored).
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
